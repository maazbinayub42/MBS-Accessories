# ============================================
# MBS Islamic Accessories — Environment Variables
# ============================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to GitHub.

# Database
# For local dev: SQLite (file-based, no server needed)
# For production: Switch to Supabase PostgreSQL connection string
DATABASE_URL="file:./dev.db"

# Supabase (production)
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Admin (for initial setup only — use Supabase Auth in production)
ADMIN_USERNAME="MBS12"
ADMIN_PASSWORD="mbs1changed"
